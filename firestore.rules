rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isStaff() {
      return signedIn() && role() == 'staff';
    }

    function isAdmin() {
      return signedIn() && role() == 'admin';
    }

    function isManager() {
      return isStaff() || isAdmin();
    }

    match /users/{uid} {
      allow create: if ownUser(uid)
        && request.resource.data.role == 'student';
      allow read: if ownUser(uid) || isAdmin();
      allow update: if isAdmin()
        || (ownUser(uid)
          && request.resource.data.role == resource.data.role
          && request.resource.data.email == resource.data.email);
      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    // `menu` is retained for compatibility with the submitted application.
    match /menu/{itemId} {
      allow read: if signedIn();
      allow create, update, delete: if isManager();
    }

    match /categories/{categoryId} {
      allow read: if signedIn();
      allow create, update, delete: if isManager();
    }

    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'Pending';
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isManager());
      allow update: if isManager();
      allow delete: if isAdmin();
    }

    match /counters/{counterId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.count == 1;
      allow update: if signedIn()
        && request.resource.data.count == resource.data.count + 1;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
